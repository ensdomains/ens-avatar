{
  "version": "2.0.0-alpha.2",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ethers": {
      "types": "./dist/chain/ethers.d.ts",
      "import": "./dist/chain/ethers.mjs",
      "require": "./dist/chain/ethers.cjs"
    },
    "./viem": {
      "types": "./dist/chain/viem.d.ts",
      "import": "./dist/chain/viem.mjs",
      "require": "./dist/chain/viem.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "rollup -c --watch",
    "build": "rollup -c && tsc -p tsconfig.build.json",
    "build:demo": "node ./example/build.js",
    "test": "jest",
    "lint": "tsdx lint",
    "size": "size-limit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint src test"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "jest": {
    "testTimeout": 20000,
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "name": "@ensdomains/ens-avatar",
  "author": "Muhammed Tanrıkulu <muhammed@ens.domains>",
  "size-limit": [
    {
      "path": "dist/index.cjs",
      "limit": "120 KB",
      "ignore": [
        "http",
        "https",
        "net",
        "dns",
        "undici"
      ]
    },
    {
      "path": "dist/index.mjs",
      "limit": "120 KB",
      "ignore": [
        "http",
        "https",
        "net",
        "dns",
        "undici"
      ]
    }
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.5",
    "@size-limit/preset-small-lib": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/url-join": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^4.0.0",
    "@typescript-eslint/parser": "^4.0.0",
    "babel-eslint": "^10.1.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.25.0",
    "eslint-config-react-app": "6",
    "eslint-plugin-import": "^2.32.0",
    "ethers": "6.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.9.1",
    "size-limit": "^11.0.1",
    "ts-jest": "^29.4.9",
    "tsdx": "^0.14.1",
    "typescript": "^4.5.5"
  },
  "dependencies": {
    "assert": "^2.1.0",
    "multiformats": "^9.6.2",
    "postcss": "^8.4.0",
    "sanitize-html": "^2.17.0",
    "undici": "^7.16.0",
    "url-join": "^4.0.1"
  },
  "peerDependencies": {
    "ethers": "^6",
    "viem": "^2"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "volta": {
    "node": "20.20.0"
  }
}
