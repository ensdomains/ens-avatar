{
  "version": "2.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "rollup -c --watch",
    "build": "rollup -c",
    "build:demo": "node ./example/build.js",
    "test": "jest",
    "size": "size-limit"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "jest": {
    "testTimeout": 20000,
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "name": "@ensdomains/ens-avatar",
  "author": "Muhammed Tanrıkulu <muhammed@ens.domains>",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "240 KB",
      "ignore": [
        "jsdom",
        "http",
        "https",
        "net",
        "dns",
        "undici"
      ]
    },
    {
      "path": "dist/index.esm.js",
      "limit": "150 KB",
      "ignore": [
        "jsdom",
        "http",
        "https",
        "net",
        "dns",
        "undici"
      ]
    }
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.5",
    "@size-limit/preset-small-lib": "^11.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/url-join": "^4.0.1",
    "dotenv": "^16.3.1",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.9.1",
    "sanitize-html": "^2.17.0",
    "size-limit": "^11.0.1",
    "ts-jest": "^29.4.9",
    "typescript": "^4.5.5"
  },
  "dependencies": {
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "dompurify": "^3.0.6",
    "ethers": "6.12.0",
    "multiformats": "^9.6.2",
    "undici": "^7.16.0",
    "url-join": "^4.0.1"
  },
  "volta": {
    "node": "20.20.0"
  }
}
